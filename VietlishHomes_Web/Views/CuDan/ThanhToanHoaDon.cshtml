@* ===== [MỚI - SEPAY] Toàn bộ trang thanh toán được làm lại với auto-polling SePay ===== *@
@* Tính năng: QR hiển thị → JS polling 5s /CuDan/KiemTraThanhToan → khi OK hiện modal thành công *@
@{
    ViewData["Title"] = "Thanh Toán Hóa Đơn – VietQR";
}

@* ===== [XÓA] Toàn bộ giao diện cũ đơn giản bên dưới đã được thay bằng UI mới: *@
@*
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0 text-center">
                ...code cũ đã xóa...
            </div>
        </div>
    </div>
</div>
*@

<style>
    /* ===== [MỚI - SEPAY] CSS riêng cho trang thanh toán ===== */
    body { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); min-height: 100vh; }

    .payment-card {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 24px;
        backdrop-filter: blur(20px);
        box-shadow: 0 25px 60px rgba(0,0,0,0.4);
        overflow: hidden;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        padding: 28px 32px;
        text-align: center;
    }

    .amount-badge {
        background: rgba(239,68,68,0.15);
        border: 2px solid rgba(239,68,68,0.4);
        border-radius: 16px;
        padding: 16px 24px;
        color: #f87171;
    }

    .qr-wrapper {
        background: white;
        border-radius: 20px;
        padding: 16px;
        display: inline-block;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .info-row {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 14px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .info-label { color: #94a3b8; font-size: 13px; }
    .info-value { color: #f1f5f9; font-weight: 600; font-size: 14px; }

    .btn-confirm {
        background: linear-gradient(135deg, #10b981, #059669);
        border: none; border-radius: 14px;
        color: white; font-weight: 700;
        padding: 14px 24px; width: 100%;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(16,185,129,0.3);
    }
    .btn-confirm:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(16,185,129,0.45); color: white; }

    .btn-back {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 12px; color: #cbd5e1;
        padding: 10px 20px; font-size: 14px;
        transition: all 0.2s;
    }
    .btn-back:hover { background: rgba(255,255,255,0.14); color: white; }

    /* Polling Status Bar */
    .status-bar {
        border-radius: 12px;
        padding: 14px 18px;
        font-size: 14px;
        display: flex; align-items: center; gap: 10px;
        transition: all 0.4s ease;
    }
    .status-waiting {
        background: rgba(251,191,36,0.1);
        border: 1px solid rgba(251,191,36,0.3);
        color: #fbbf24;
    }
    .status-success {
        background: rgba(16,185,129,0.15);
        border: 1px solid rgba(16,185,129,0.4);
        color: #34d399;
    }
    .status-error {
        background: rgba(239,68,68,0.1);
        border: 1px solid rgba(239,68,68,0.3);
        color: #f87171;
    }

    /* Spinner nhỏ */
    .spinner-sm {
        width: 18px; height: 18px;
        border: 2px solid rgba(251,191,36,0.3);
        border-top-color: #fbbf24;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex-shrink: 0;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* Modal thanh toán thành công */
    .success-overlay {
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.75);
        display: none; align-items: center; justify-content: center;
        z-index: 9999; backdrop-filter: blur(8px);
    }
    .success-box {
        background: linear-gradient(135deg, #0f2027, #1a3a2a);
        border: 1px solid rgba(16,185,129,0.4);
        border-radius: 24px; padding: 48px 40px;
        text-align: center; max-width: 440px; width: 90%;
        box-shadow: 0 0 80px rgba(16,185,129,0.2);
        animation: popIn 0.4s cubic-bezier(0.34,1.56,0.64,1);
    }
    @@keyframes popIn { from { transform: scale(0.7); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .checkmark-circle {
        width: 90px; height: 90px; border-radius: 50%;
        background: linear-gradient(135deg, #10b981, #059669);
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 20px; font-size: 44px;
        box-shadow: 0 0 40px rgba(16,185,129,0.5);
        animation: pulse 2s infinite;
    }
    @@keyframes pulse { 0%,100% { box-shadow: 0 0 40px rgba(16,185,129,0.5); } 50% { box-shadow: 0 0 70px rgba(16,185,129,0.8); } }

    /* Countdown redirect */
    #redirect-countdown { color: #34d399; font-weight: 700; }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="payment-card">

                @* Header *@
                <div class="card-header-custom">
                    <div style="font-size:36px; margin-bottom:8px;">💳</div>
                    <h4 style="color:white; font-weight:700; margin:0;">THANH TOÁN TRỰC TUYẾN</h4>
                    <p style="color:rgba(255,255,255,0.7); margin:6px 0 0; font-size:13px;">
                        Quét QR bằng ứng dụng Mobile Banking bất kỳ
                    </p>
                </div>

                <div style="padding: 28px 28px 32px;">

                    @* Số tiền *@
                    <div class="amount-badge text-center mb-4">
                        <div style="font-size:12px; color:#94a3b8; margin-bottom:4px; letter-spacing:1px;">SỐ TIỀN CẦN THANH TOÁN</div>
                        <div style="font-size:32px; font-weight:800; letter-spacing:-1px;">
                            @String.Format("{0:N0}", ViewBag.SoTien) <span style="font-size:18px;">VNĐ</span>
                        </div>
                    </div>

                    @* QR Code *@
                    <div class="text-center mb-4">
                        <div class="qr-wrapper">
                            <img src="@ViewBag.LinkQR"
                                 alt="Mã VietQR"
                                 id="qr-image"
                                 style="max-height:280px; max-width:280px;" />
                        </div>
                        <div style="color:#64748b; font-size:11px; margin-top:10px;">
                            🔒 QR được mã hóa bởi VietQR – Tiêu chuẩn NAPAS
                        </div>
                    </div>

                    @* Thông tin chuyển khoản *@
                    <div class="d-flex flex-column gap-2 mb-4">
                        <div class="info-row">
                            <span class="info-label">📄 Mã hóa đơn</span>
                            <span class="info-value" style="color:#818cf8; font-weight:700;">@ViewBag.MaHoaDon</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">✏️ Nội dung CK</span>
                            <span class="info-value" id="noi-dung-ck">@ViewBag.NoiDungCK</span>
                        </div>
                    </div>

                    @* ===== [MỚI - SEPAY] Status bar tự động kiểm tra ===== *@
                    <div class="status-bar status-waiting mb-3" id="status-bar">
                        <div class="spinner-sm" id="status-spinner"></div>
                        <div>
                            <div style="font-weight:600;">Đang chờ xác nhận giao dịch...</div>
                            <div style="font-size:12px; opacity:0.8;">
                                Hệ thống tự động kiểm tra mỗi 5 giây qua SePay
                            </div>
                        </div>
                    </div>
                    @* ===== [KẾT THÚC MỚI - SEPAY] ===== *@

                    @* ===== [GIỮ LẠI] Nút xác nhận thủ công - fallback khi webhook chưa kết nối ===== *@
                    <form asp-action="XacNhanThanhToanThanhCong" method="post" id="manual-confirm-form">
                        <input type="hidden" name="maHoaDon" value="@ViewBag.MaHoaDon" />
                        <input type="hidden" name="maCuDan"  value="@ViewBag.MaCuDan" />
                        <button type="submit" class="btn-confirm mb-3" id="btn-manual-confirm">
                            ✅ Tôi đã chuyển khoản xong (Xác nhận thủ công)
                        </button>
                    </form>
                    @* ===== [KẾT THÚC GIỮ LẠI] ===== *@

                    <div class="text-center">
                        <a href="javascript:history.back()" class="btn-back btn">⬅️ Quay lại</a>
                    </div>

                    <div style="color:#475569; font-size:11px; text-align:center; margin-top:16px;">
                        ⚠️ Giữ nguyên nội dung chuyển khoản để hệ thống tự động xác nhận
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ===== [MỚI - SEPAY] Modal hiển thị khi thanh toán thành công ===== *@
<div class="success-overlay" id="success-overlay">
    <div class="success-box">
        <div class="checkmark-circle">✅</div>
        <h3 style="color:#34d399; font-weight:800; margin-bottom:10px;">THANH TOÁN THÀNH CÔNG!</h3>
        <p style="color:#94a3b8; margin-bottom:6px;">
            Hệ thống SePay đã xác nhận giao dịch của bạn.
        </p>
        <p style="color:#64748b; font-size:13px; margin-bottom:24px;">
            Phiếu thu đã được tạo tự động trong hệ thống.
        </p>
        <div style="background:rgba(16,185,129,0.1); border-radius:10px; padding:12px; margin-bottom:20px; color:#34d399; font-size:14px;">
            🔄 Tự động chuyển về trang chủ sau <span id="redirect-countdown">5</span> giây...
        </div>
        <a href="/CuDan/ThongTinPhongThue?maCuDan=@ViewBag.MaCuDan"
           style="background:linear-gradient(135deg,#10b981,#059669); border:none; border-radius:12px; color:white;
                  padding:12px 28px; font-weight:700; text-decoration:none; display:inline-block;">
            🏠 Về Trang Chủ Ngay
        </a>
    </div>
</div>
@* ===== [KẾT THÚC MỚI - SEPAY MODAL] ===== *@

@section Scripts {
    <script>
    // ===== [MỚI - SEPAY] Auto-polling: Kiểm tra trạng thái thanh toán mỗi 5 giây =====
    (function () {
        const maHoaDon   = '@ViewBag.MaHoaDon';
        const maCuDan    = '@ViewBag.MaCuDan';
        const pollUrl    = '/CuDan/KiemTraThanhToan?maHoaDon=' + encodeURIComponent(maHoaDon);
        const statusBar  = document.getElementById('status-bar');
        const overlay    = document.getElementById('success-overlay');
        const spinner    = document.getElementById('status-spinner');
        let   pollCount  = 0;
        let   intervalId = null;
        let   daDong     = false;

        // --- Hàm gọi API kiểm tra ---
        async function kiemTraThanhToan() {
            if (daDong) return;
            try {
                pollCount++;
                const res  = await fetch(pollUrl, { cache: 'no-store' });
                const data = await res.json();

                if (data.daDuocThanhToan) {
                    clearInterval(intervalId);
                    daDong = true;
                    hienThiThanhCong();
                }
            } catch (err) {
                console.warn('[SePay Poll #' + pollCount + '] Lỗi kết nối:', err);
            }
        }

        // --- Hiện modal thành công và đếm ngược ---
        function hienThiThanhCong() {
            overlay.style.display = 'flex';
            if (spinner) spinner.style.display = 'none';
            statusBar.className   = 'status-bar status-success mb-3';
            statusBar.innerHTML   = '<span style="font-size:22px;">✅</span>'
                + '<div><div style="font-weight:700;">Giao dịch đã được xác nhận tự động!</div>'
                + '<div style="font-size:12px;opacity:0.8;">SePay đã ghi nhận thành công</div></div>';

            let dem = 5;
            const cdEl    = document.getElementById('redirect-countdown');
            const cdTimer = setInterval(() => {
                dem--;
                if (cdEl) cdEl.textContent = dem;
                if (dem <= 0) {
                    clearInterval(cdTimer);
                    const url = maCuDan
                        ? '/CuDan/ThongTinPhongThue?maCuDan=' + encodeURIComponent(maCuDan)
                        : '/CuDan/ThongTinPhongThue';
                    window.location.href = url;
                }
            }, 1000);
        }

        // --- Khởi động: kiểm tra ngay lần đầu, rồi mỗi 5 giây ---
        kiemTraThanhToan();
        intervalId = setInterval(kiemTraThanhToan, 5000);

        // --- Dừng tự động sau 10 phút ---
        setTimeout(() => {
            if (!daDong) {
                clearInterval(intervalId);
                daDong = true;
                statusBar.className = 'status-bar status-error mb-3';
                statusBar.innerHTML = '<span style="font-size:20px;">⚠️</span>'
                    + '<div><div style="font-weight:600;">Hết thời gian tự động kiểm tra (10 phút)</div>'
                    + '<div style="font-size:12px;">Nếu đã chuyển khoản, nhấn nút xác nhận thủ công bên dưới</div></div>';
            }
        }, 10 * 60 * 1000);
    })();
    // ===== [KẾT THÚC MỚI - SEPAY POLLING SCRIPT] =====
    </script>
}