@model VietlishHomes_Web.Models.HopDong

@{
    ViewData["Title"] = "Chi Tiết Hợp Đồng Thuê Phòng";
}

@* ===== TRANG CHI TIẾT HỢP ĐỒNG ===== *@

<div style="max-width:900px; margin:0 auto; padding:12px 0;">
    @* Back Button & Header *@
    <div style="margin-bottom:24px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
        <div style="display:flex; align-items:center; gap:12px;">
            <a href="javascript:history.back()" class="btn-vl-ghost" style="font-size:13px; font-weight:600; padding:8px 14px;">
                <i class="bi bi-arrow-left"></i> Quay lại phòng
            </a>
            <div>
                <h3 style="font-size:22px; font-weight:800; color:var(--text); margin:0; letter-spacing:-0.5px;">📜 Hợp Đồng Điện Tử</h3>
                <p style="color:var(--text-2); font-size:13px; margin:4px 0 0;">Quản lý và tra cứu điều khoản thuê phòng</p>
            </div>
        </div>
        <div>
            @if (Model != null)
            {
                <span class="@(ViewBag.ConHan == true ? "badge-paid" : "badge-danger")" style="font-size:13px; padding:6px 14px;">
                    @(ViewBag.ConHan == true ? "🟢 Đang hiệu lực" : "🔴 Đã hết hạn")
                </span>
            }
        </div>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="vl-alert-warning" style="box-shadow:var(--shadow);">
            <span style="font-size:20px;">⚠️</span>
            @ViewBag.Message
        </div>
    }
    else if (Model != null)
    {
        <div class="vl-card" style="box-shadow:var(--shadow-md);">
            @* Card Header *@
            <div class="vl-card-header" style="background:linear-gradient(135deg, var(--primary-light), var(--purple-light)); border-bottom:1px solid var(--border); padding:24px 30px;">
                <div>
                    <h4 style="margin:0; font-weight:800; color:var(--primary); font-size:18px; letter-spacing:-0.3px;">HỢP ĐỒNG THUÊ PHÒNG ĐIỆN TỬ</h4>
                    <p style="margin:4px 0 0; color:var(--text-2); font-size:12px; font-weight:500;">
                        Mã văn bản: <strong style="color:var(--text);">@Model.MaHopDong</strong>
                    </p>
                </div>
                <div style="font-size:24px;">📝</div>
            </div>

            @* Card Body *@
            <div class="vl-card-body" style="padding:30px;">
                
                @* Columns *@
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:32px; margin-bottom:32px; flex-wrap:wrap;">
                    
                    @* Column 1: Người đại diện *@
                    <div style="background:#f8fafc; border:1px solid var(--border); border-radius:12px; padding:20px;">
                        <h5 style="font-weight:700; color:var(--primary); font-size:14px; margin-bottom:16px; border-bottom:2px solid var(--border); padding-bottom:8px; display:flex; align-items:center; gap:8px;">
                            <i class="bi bi-person-fill"></i> Bên Thuê (Người Đại Diện)
                        </h5>
                        <div style="display:flex; flex-direction:column; gap:10px; font-size:13px; color:var(--text-2);">
                            <div>Mã đại diện: <strong style="color:var(--text);">@Model.MaNguoiDaiDien</strong></div>
                            <div>
                                Thành viên cùng lưu trú: 
                                @if (Model.HopDongCuDans != null && Model.HopDongCuDans.Any())
                                {
                                    <strong style="color:var(--primary);">@Model.HopDongCuDans.Count người</strong>
                                }
                                else
                                {
                                    <span style="font-style:italic;">Không đăng ký đi kèm</span>
                                }
                            </div>
                        </div>
                    </div>

                    @* Column 2: Phòng thuê *@
                    <div style="background:#f8fafc; border:1px solid var(--border); border-radius:12px; padding:20px;">
                        <h5 style="font-weight:700; color:var(--primary); font-size:14px; margin-bottom:16px; border-bottom:2px solid var(--border); padding-bottom:8px; display:flex; align-items:center; gap:8px;">
                            <i class="bi bi-house-door-fill"></i> Thông Tin Phòng Thuê
                        </h5>
                        <div style="display:flex; flex-direction:column; gap:10px; font-size:13px; color:var(--text-2);">
                            <div>Mã phòng sơ đồ: <strong style="color:var(--text);">@Model.MaPhong</strong></div>
                            <div>Tên phòng thực tế: <strong style="color:var(--primary);">@ViewBag.TenPhong</strong></div>
                            <div>Giá thuê định kỳ: <strong style="color:var(--danger); font-size:14px;">@Model.GiaThue?.ToString("N0") VNĐ/Tháng</strong></div>
                        </div>
                    </div>

                </div>

                @* Table: Chi tiết hợp đồng *@
                <div>
                    <h5 style="font-weight:700; color:var(--text); font-size:14px; margin-bottom:16px; display:flex; align-items:center; gap:8px;">
                        <i class="bi bi-card-list"></i> Điều Khoản & Ràng Buộc Hợp Đồng
                    </h5>
                    
                    <table class="vl-table" style="border:1px solid var(--border); border-radius:8px; overflow:hidden;">
                        <tbody>
                            <tr>
                                <td style="background:#f8fafc; font-weight:700; width:35%; color:var(--text-2);">Ngày ký kết bàn giao</td>
                                <td style="font-weight:600;">@Model.NgayBatDau?.ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <td style="background:#f8fafc; font-weight:700; color:var(--text-2);">Ngày đáo hạn hợp đồng</td>
                                <td style="font-weight:600;">@Model.NgayKetThuc?.ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <td style="background:#f8fafc; font-weight:700; color:var(--text-2);">Tiền đặt cọc giữ phòng</td>
                                <td style="font-weight:700; color:var(--success);">@Model.TienCoc?.ToString("N0") VNĐ</td>
                            </tr>
                            <tr>
                                <td style="background:#f8fafc; font-weight:700; color:var(--text-2);">Giá điện định mức</td>
                                <td style="font-weight:600;">@Model.GiaDienChot?.ToString("N0") đ/kWh</td>
                            </tr>
                            <tr>
                                <td style="background:#f8fafc; font-weight:700; color:var(--text-2);">Giá nước định mức</td>
                                <td style="font-weight:600;">@Model.GiaNuocChot?.ToString("N0") đ/m³</td>
                            </tr>
                            <tr>
                                <td style="background:#f8fafc; font-weight:700; color:var(--text-2);">Ghi chú kèm theo</td>
                                <td style="color:var(--text-2); font-style:italic;">@(string.IsNullOrWhiteSpace(Model.GhiChu) ? "Không có ghi chú nào" : Model.GhiChu)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

            </div>

            @* Card Footer *@
            <div style="background:#f8fafc; border-top:1px solid var(--border); padding:16px 30px; display:flex; justify-content:space-between; align-items:center; font-size:12px; color:var(--text-3); font-weight:500;">
                <span>Hệ thống hợp đồng điện tử Vietlish Homes</span>
                <span>An tâm lập nghiệp</span>
            </div>
        </div>
    }
</div>