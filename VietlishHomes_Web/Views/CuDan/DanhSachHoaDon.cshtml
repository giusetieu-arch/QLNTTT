@model IEnumerable<VietlishHomes_Web.Models.HoaDon>
@{
    ViewData["Title"] = "Hóa Đơn – " + ViewBag.MaPhong;
    var allItems       = (Model ?? Enumerable.Empty<VietlishHomes_Web.Models.HoaDon>()).ToList();
    int tongHD         = allItems.Count;
    int daTT           = allItems.Count(h => h.TrangThai == "Đã thanh toán" || h.ConNo == 0);
    int chuaTT         = tongHD - daTT;
    decimal tongTienNo = allItems.Where(h => h.ConNo > 0).Sum(h => h.ConNo ?? 0);
}

@* ===== TRANG LỊCH SỬ HÓA ĐƠN ===== *@

@* Back button & Header *@
<div style="margin-bottom:28px;display:flex;align-items:center;gap:16px;">
    <a href="javascript:history.back()" class="btn-vl-ghost" style="font-size:13px; font-weight:600; padding:8px 14px;">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
    <div>
        <div style="font-size:22px;font-weight:800;color:var(--text);letter-spacing:-0.5px;">💰 Lịch Sử Hóa Đơn</div>
        <div style="font-size:13px;color:var(--text-2);font-weight:500;">
            Phòng <span style="color:var(--primary);font-weight:700;">@ViewBag.MaPhong</span>
        </div>
    </div>
</div>

@if (ViewBag.Message != null)
{
    <div class="vl-alert-info" style="box-shadow:var(--shadow);">
        <span style="font-size:20px;">ℹ️</span>
        @ViewBag.Message
    </div>
}
else
{
    @* Summary stats *@
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-bottom:28px;">
        <div class="vl-card" style="padding:20px; box-shadow:var(--shadow); display:flex; justify-content:space-between; align-items:center;">
            <div>
                <div style="font-size:11px;color:var(--text-3);font-weight:700;letter-spacing:0.8px;text-transform:uppercase;">TỔNG HÓA ĐƠN</div>
                <div style="font-size:32px;font-weight:800;color:var(--text);margin-top:6px;line-height:1;">@tongHD</div>
            </div>
            <div style="width:40px;height:40px;border-radius:10px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-size:20px;">📊</div>
        </div>
        <div class="vl-card" style="padding:20px; border-left:4px solid var(--success); box-shadow:var(--shadow); display:flex; justify-content:space-between; align-items:center;">
            <div>
                <div style="font-size:11px;color:var(--text-3);font-weight:700;letter-spacing:0.8px;text-transform:uppercase;">ĐÃ THANH TOÁN</div>
                <div style="font-size:32px;font-weight:800;color:var(--success);margin-top:6px;line-height:1;">@daTT</div>
            </div>
            <div style="width:40px;height:40px;border-radius:10px;background:var(--success-light);display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--success)">✅</div>
        </div>
        <div class="vl-card" style="padding:20px; border-left:4px solid var(--warning); box-shadow:var(--shadow); display:flex; justify-content:space-between; align-items:center;">
            <div>
                <div style="font-size:11px;color:var(--text-3);font-weight:700;letter-spacing:0.8px;text-transform:uppercase;">DƯ NỢ CÒN LẠI</div>
                <div style="font-size:24px;font-weight:800;color:var(--warning);margin-top:6px;line-height:1;">@tongTienNo.ToString("N0") đ</div>
            </div>
            <div style="width:40px;height:40px;border-radius:10px;background:var(--warning-light);display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--warning)">⚠️</div>
        </div>
    </div>

    @* Table *@
    <div class="vl-card" style="box-shadow:var(--shadow);">
        <div class="vl-card-header" style="background:#fafafa;">
            <div style="font-weight:700;font-size:15px;color:var(--text);"><i class="bi bi-list-task"></i> Danh Sách Hóa Đơn Chi Tiết</div>
            <span style="font-size:12px;color:var(--text-2);font-weight:600;">@tongHD hóa đơn</span>
        </div>
        <div style="overflow-x:auto;">
            <table class="vl-table">
                <thead>
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Kỳ hạn</th>
                        <th>Ngày lập</th>
                        <th>Tổng tiền</th>
                        <th>Đã trả</th>
                        <th>Còn nợ</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool paid = item.TrangThai == "Đã thanh toán" || item.ConNo == 0;
                        <tr>
                            <td>
                                <span style="font-weight:700;color:var(--primary);font-size:13px;">@item.MaHoaDon</span>
                            </td>
                            <td>
                                <span style="background:#f1f5f9; border:1px solid var(--border); border-radius:6px; padding:3px 8px; font-size:12px; color:var(--text-2); font-weight:600;">
                                    @item.KyHoaDon
                                </span>
                            </td>
                            <td style="color:var(--text-2); font-weight:500;">@item.NgayLap?.ToString("dd/MM/yyyy")</td>
                            <td style="font-weight:600; color:var(--text);">@item.TongTien?.ToString("N0") đ</td>
                            <td style="color:var(--success); font-weight:600;">@item.DaThanhToan?.ToString("N0") đ</td>
                            <td style="color:@(paid ? "var(--success)" : "var(--warning)"); font-weight:700;">
                                @item.ConNo?.ToString("N0") đ
                            </td>
                            <td>
                                @if (paid)
                                {
                                    <span class="badge-paid"><i class="bi bi-check-circle-fill"></i> Đã TT</span>
                                }
                                else
                                {
                                    <span class="badge-unpaid"><i class="bi bi-clock-history"></i> Chờ TT</span>
                                }
                            </td>
                            <td>
                                @if (paid)
                                {
                                    <span style="color:var(--text-3); font-size:12px; font-weight:600;"><i class="bi bi-shield-check text-success"></i> Hoàn tất</span>
                                }
                                else
                                {
                                    @* Thêm maCuDan để redirect chính xác sau thanh toán *@
                                    <a asp-controller="CuDan"
                                       asp-action="ThanhToanHoaDon"
                                       asp-route-maHoaDon="@item.MaHoaDon"
                                       asp-route-maCuDan="@ViewBag.MaCuDan"
                                       class="btn-vl-primary" style="font-size:12px; padding:6px 12px; gap:4px; box-shadow:none;">
                                        <i class="bi bi-credit-card"></i> Thanh toán
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@* ===== KẾT THÚC DANH SÁCH HÓA ĐƠN ===== *@