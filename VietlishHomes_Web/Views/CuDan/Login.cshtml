@{
    ViewData["Title"] = "Đăng Nhập – Vietlish Homes";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            background: #f8fafc;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
        }
        /* Subtle background pattern */
        body::before {
            content: '';
            position: fixed; inset: 0;
            background:
                radial-gradient(circle at 20% 20%, rgba(37,99,235,0.06) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(124,58,237,0.05) 0%, transparent 50%);
            pointer-events: none;
        }

        .login-wrap { position: relative; z-index: 1; width: 100%; max-width: 420px; }

        /* Logo */
        .logo-area { text-align: center; margin-bottom: 28px; }
        .logo-icon {
            width: 64px; height: 64px; border-radius: 18px;
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 30px; margin-bottom: 14px;
            box-shadow: 0 8px 24px rgba(37,99,235,0.25);
        }
        .logo-name { font-size: 22px; font-weight: 800; color: #0f172a; }
        .logo-sub  { font-size: 13px; color: #94a3b8; margin-top: 4px; }

        /* Card */
        .login-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 32px 32px 28px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        }
        .card-title { font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 4px; }
        .card-sub   { font-size: 13px; color: #94a3b8; margin-bottom: 24px; }

        /* Form */
        .field { margin-bottom: 16px; }
        .field-label {
            display: block; font-size: 11px; font-weight: 700;
            color: #64748b; letter-spacing: 0.5px;
            text-transform: uppercase; margin-bottom: 6px;
        }
        .field-input {
            width: 100%;
            background: #f8fafc; border: 1.5px solid #e2e8f0;
            border-radius: 10px; color: #0f172a;
            padding: 11px 14px; font-size: 14px;
            font-family: 'Inter', sans-serif;
            transition: all 0.15s;
        }
        .field-input:focus {
            outline: none; border-color: #2563eb;
            background: white;
            box-shadow: 0 0 0 3px rgba(37,99,235,0.08);
        }
        .field-input::placeholder { color: #cbd5e1; }

        /* Button */
        .btn-login {
            width: 100%;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border: none; border-radius: 10px;
            color: white; font-weight: 700; font-size: 14px;
            padding: 13px; cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 2px 8px rgba(37,99,235,0.25);
            margin-top: 6px;
        }
        .btn-login:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(37,99,235,0.35); }
        .btn-login:active { transform: translateY(0); }

        /* Error */
        .error-box {
            background: #fee2e2; border: 1px solid #fecaca;
            border-radius: 10px; padding: 11px 14px;
            color: #dc2626; font-size: 13px;
            margin-bottom: 18px;
            display: flex; align-items: center; gap: 8px;
        }

        /* Divider */
        .divider { height: 1px; background: #f1f5f9; margin: 20px 0; }

        .login-footer { text-align: center; margin-top: 20px; color: #cbd5e1; font-size: 12px; }

        /* Info badge */
        .info-chip {
            display: inline-flex; align-items: center; gap: 6px;
            background: #eff6ff; border: 1px solid #bfdbfe;
            border-radius: 8px; padding: 6px 12px;
            font-size: 12px; color: #2563eb; font-weight: 500;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="login-wrap">
        @* Logo *@
        <div class="logo-area">
            <div class="logo-icon">🏠</div>
            <div class="logo-name">Vietlish Homes</div>
            <div class="logo-sub">Cổng thông tin dành cho Cư dân</div>
        </div>

        <div class="login-card">
            <div class="card-title">Đăng nhập</div>
            <div class="card-sub">Sử dụng tài khoản được cung cấp bởi Ban Quản Lý</div>

            @if (ViewBag.Error != null)
            {
                <div class="error-box">
                    <span>⚠️</span> @ViewBag.Error
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="field">
                    <label class="field-label" for="txtUsername">Tên đăng nhập</label>
                    <input class="field-input" id="txtUsername" name="username"
                           type="text" placeholder="Nhập username..." required autocomplete="username"/>
                </div>
                <div class="field">
                    <label class="field-label" for="txtPassword">Mật khẩu</label>
                    <input class="field-input" id="txtPassword" name="password"
                           type="password" placeholder="••••••••" required autocomplete="current-password"/>
                </div>
                <button type="submit" class="btn-login">
                    Đăng Nhập →
                </button>
            </form>
        </div>

        <div class="login-footer">
            © @DateTime.Now.Year Vietlish Homes &nbsp;·&nbsp; Quản lý Nhà trọ thông minh
        </div>
    </div>
</body>
</html>