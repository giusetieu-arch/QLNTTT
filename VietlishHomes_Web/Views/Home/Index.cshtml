@{
    ViewData["Title"] = "Dashboard – Quản lý Nhà trọ";
    var phongs        = ViewBag.DanhSachPhong  as IEnumerable<VietlishHomes_Web.Models.Phong>;
    var hoaDonGanDay  = ViewBag.HoaDonGanDay   as IEnumerable<VietlishHomes_Web.Models.HoaDon>;
    var baoHongGanDay = ViewBag.BaoHongGanDay  as IEnumerable<VietlishHomes_Web.Models.CongViec>;
}

@* ===== DASHBOARD ADMIN – LIGHT THEME ===== *@

@* ---------- GREETING ---------- *@
<div style="margin-bottom:32px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
    <div>
        <h2 style="font-weight:800; font-size:26px; margin:0; color:var(--text); letter-spacing:-0.5px;">
            👋 Chào mừng, Ban Quản Lý!
        </h2>
        <p style="color:var(--text-2); margin:6px 0 0; font-size:14px;">
            @DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
            · Hệ thống quản lý thông minh <span style="font-weight:600; color:var(--primary);">Vietlish Homes</span>
        </p>
    </div>
    <div style="background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:10px 16px; box-shadow:var(--shadow); display:flex; align-items:center; gap:8px;">
        <span style="font-size:16px;">🏢</span>
        <span style="font-size:13px; font-weight:600; color:var(--text-2);">Khu vực hoạt động: Toàn bộ</span>
    </div>
</div>

@* ---------- STATS CARDS ---------- *@
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:20px; margin-bottom:32px;">

    @* Tổng phòng *@
    <div class="stat-card" style="position:relative; overflow:hidden;">
        <div style="position:absolute; top:0; left:0; width:4px; height:100%; background:var(--primary);"></div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <div>
                <div style="color:var(--text-3);font-size:11px;font-weight:700;letter-spacing:0.8px;margin-bottom:8px;text-transform:uppercase;">TỔNG PHÒNG</div>
                <div style="font-size:36px;font-weight:800;color:var(--text);line-height:1;">@(ViewBag.TongPhong ?? 0)</div>
            </div>
            <div style="width:48px;height:48px;border-radius:12px;background:var(--primary-light);display:flex;align-items:center;justify-content:center;font-size:22px;">🏠</div>
        </div>
        <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border);font-size:12px;color:var(--text-2);display:flex;gap:12px;">
            <span style="color:var(--success);font-weight:600;"><i class="bi bi-check-circle-fill"></i> @(ViewBag.PhongDangThue ?? 0) đang thuê</span>
            <span style="color:var(--warning);font-weight:600;"><i class="bi bi-dash-circle-fill"></i> @(ViewBag.PhongTrong ?? 0) trống</span>
        </div>
    </div>

    @* Cư dân *@
    <div class="stat-card" style="position:relative; overflow:hidden;">
        <div style="position:absolute; top:0; left:0; width:4px; height:100%; background:var(--purple);"></div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <div>
                <div style="color:var(--text-3);font-size:11px;font-weight:700;letter-spacing:0.8px;margin-bottom:8px;text-transform:uppercase;">CƯ DÂN HIỆN TẠI</div>
                <div style="font-size:36px;font-weight:800;color:var(--text);line-height:1;">@(ViewBag.TongCuDan ?? 0)</div>
            </div>
            <div style="width:48px;height:48px;border-radius:12px;background:var(--purple-light);display:flex;align-items:center;justify-content:center;font-size:22px;color:var(--purple)">👥</div>
        </div>
        <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border);font-size:12px;color:var(--text-2);">
            <i class="bi bi-people-fill"></i> Đang hoạt động trên hệ thống Web
        </div>
    </div>

    @* Hóa đơn chưa thanh toán *@
    <div class="stat-card" style="position:relative; overflow:hidden; border-color:rgba(217,119,6,0.2);">
        <div style="position:absolute; top:0; left:0; width:4px; height:100%; background:var(--warning);"></div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <div>
                <div style="color:var(--text-3);font-size:11px;font-weight:700;letter-spacing:0.8px;margin-bottom:8px;text-transform:uppercase;">HÓA ĐƠN CHƯA TT</div>
                <div style="font-size:36px;font-weight:800;color:var(--warning);line-height:1;">@(ViewBag.HoaDonChuaTT ?? 0)</div>
            </div>
            <div style="width:48px;height:48px;border-radius:12px;background:var(--warning-light);display:flex;align-items:center;justify-content:center;font-size:22px;">💰</div>
        </div>
        <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border);font-size:12px;color:var(--text-2);">
            @if ((ViewBag.HoaDonChuaTT ?? 0) > 0)
            {
                <span style="color:var(--warning);font-weight:600;"><i class="bi bi-exclamation-triangle-fill"></i> Yêu cầu đôn đốc thanh toán</span>
            }
            else
            {
                <span style="color:var(--success);font-weight:600;"><i class="bi bi-check-all"></i> Đã thu đủ hóa đơn tháng này</span>
            }
        </div>
    </div>

    @* Báo hỏng chờ xử lý *@
    <div class="stat-card" style="position:relative; overflow:hidden; border-color:rgba(220,38,36,0.2);">
        <div style="position:absolute; top:0; left:0; width:4px; height:100%; background:var(--danger);"></div>
        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <div>
                <div style="color:var(--text-3);font-size:11px;font-weight:700;letter-spacing:0.8px;margin-bottom:8px;text-transform:uppercase;">SỰ CỐ CẦN XỬ LÝ</div>
                <div style="font-size:36px;font-weight:800;color:var(--danger);line-height:1;">@(ViewBag.BaoHongChuaXL ?? 0)</div>
            </div>
            <div style="width:48px;height:48px;border-radius:12px;background:var(--danger-light);display:flex;align-items:center;justify-content:center;font-size:22px;">🔧</div>
        </div>
        <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border);font-size:12px;color:var(--text-2);">
            @if ((ViewBag.BaoHongChuaXL ?? 0) > 0)
            {
                <span style="color:var(--danger);font-weight:600;"><i class="bi bi-wrench-adjustable-circle-fill"></i> Cần kỹ thuật viên xử lý gấp</span>
            }
            else
            {
                <span style="color:var(--success);font-weight:600;"><i class="bi bi-shield-check"></i> An toàn, chưa có sự cố mới</span>
            }
        </div>
    </div>
</div>

@* ---------- 2 COL: ROOMS + INVOICES ---------- *@
<div style="display:grid;grid-template-columns:1.4fr 1fr;gap:24px;margin-bottom:24px;">

    @* Danh sách phòng *@
    <div class="vl-card">
        <div class="vl-card-header">
            <div>
                <div style="font-weight:700;font-size:16px;color:var(--text);">🏠 Danh Sách Phòng Cho Thuê</div>
                <div style="color:var(--text-2);font-size:12px;margin-top:2px;">Danh sách phòng và trạng thái chi tiết</div>
            </div>
            <a href="/CuDan/Login" class="btn-vl-primary" style="font-size:12px;padding:6px 14px;">
                <i class="bi bi-person-workspace"></i> Vào Cổng Cư Dân
            </a>
        </div>
        <div style="overflow-x:auto;">
            @if (phongs != null && phongs.Any())
            {
                <table class="vl-table">
                    <thead>
                        <tr>
                            <th>Mã Phòng / Tên</th>
                            <th>Toà nhà</th>
                            <th>Giá thuê / Tháng</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in phongs)
                        {
                            bool dangThue = p.TrangThai == "Đang thuê" || p.TrangThai == "Có người thuê";
                            <tr>
                                <td>
                                    <span style="font-weight:700;color:var(--primary);">@p.MaPhong</span>
                                    <br/>
                                    <span style="font-size:11px;color:var(--text-2);">@p.TenPhong</span>
                                </td>
                                <td style="color:var(--text-2);font-weight:500;">@(p.MaToaNhaNavigation?.TenToaNha ?? p.MaToaNha ?? "Chưa rõ")</td>
                                <td style="color:var(--text);font-weight:600;">@p.GiaThue?.ToString("N0") đ</td>
                                <td>
                                    @if (dangThue)
                                    {
                                        <span class="badge-paid"><i class="bi bi-circle-fill" style="font-size:7px; vertical-align:middle; margin-right:4px;"></i> Đang thuê</span>
                                    }
                                    else
                                    {
                                        <span class="badge-unpaid" style="background:#f1f5f9; color:#475569; border-color:#e2e8f0;">
                                            <i class="bi bi-circle" style="font-size:7px; vertical-align:middle; margin-right:4px;"></i> @(p.TrangThai ?? "Trống")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a href="/CuDan/DanhSachHoaDon?maPhong=@p.MaPhong" class="btn-vl-ghost" style="font-size:11px;padding:5px 10px; gap:4px;">
                                        <i class="bi bi-receipt"></i> Hóa đơn
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div style="padding:48px;text-align:center;color:var(--text-3);">
                    <div style="font-size:44px;margin-bottom:12px;">🏗️</div>
                    <div style="font-weight:500; font-size:14px; color:var(--text-2);">Chưa có dữ liệu phòng trong hệ thống</div>
                </div>
            }
        </div>
    </div>

    @* Hóa đơn + Báo hỏng *@
    <div style="display:flex;flex-direction:column;gap:24px;">

        @* Hóa đơn chưa TT *@
        <div class="vl-card">
            <div class="vl-card-header" style="background:#fffcf5;">
                <div style="font-weight:700;font-size:14px;color:var(--warning);"><i class="bi bi-cash-stack"></i> Hóa đơn Chưa Thanh Toán</div>
            </div>
            @if (hoaDonGanDay != null && hoaDonGanDay.Any())
            {
                <div style="padding:8px 0;">
                    @foreach (var hd in hoaDonGanDay)
                    {
                        <div style="padding:14px 20px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);">
                            <div>
                                <div style="font-weight:700;font-size:13px;color:var(--text);">@hd.MaHoaDon</div>
                                <div style="font-size:11px;color:var(--text-2);margin-top:2px;">
                                    Phòng <span style="font-weight:600;color:var(--primary);">@hd.MaPhong</span> · @hd.NgayLap?.ToString("dd/MM/yyyy")
                                </div>
                            </div>
                            <div style="text-align:right;">
                                <div style="color:var(--warning);font-weight:700;font-size:13px;">@hd.ConNo?.ToString("N0") đ</div>
                                <a href="/CuDan/DanhSachHoaDon?maPhong=@hd.MaPhong" style="font-size:11px;color:var(--primary);text-decoration:none;font-weight:600;">Xem chi tiết →</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="padding:32px;text-align:center;color:var(--success);font-size:13px;font-weight:500;">
                    <i class="bi bi-shield-check" style="font-size:24px;display:block;margin-bottom:8px;"></i>
                    Không có hóa đơn tồn đọng
                </div>
            }
        </div>

        @* Báo hỏng *@
        <div class="vl-card">
            <div class="vl-card-header" style="background:#fff5f5;">
                <div style="font-weight:700;font-size:14px;color:var(--danger);"><i class="bi bi-exclamation-octagon"></i> Yêu Cầu Báo Hỏng Gần Đây</div>
            </div>
            @if (baoHongGanDay != null && baoHongGanDay.Any())
            {
                <div style="padding:8px 0;">
                    @foreach (var bh in baoHongGanDay)
                    {
                        <div style="padding:14px 20px;border-bottom:1px solid var(--border);">
                            <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                                <div>
                                    <div style="font-weight:700;font-size:13px;color:var(--text);">@bh.TieuDe</div>
                                    <div style="font-size:11px;color:var(--text-2);margin-top:2px;">
                                        Phòng <span style="font-weight:600;color:var(--primary);">@bh.MaPhong</span> · @bh.NgayBao?.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                                <span class="badge-danger" style="font-size:10px;padding:2px 8px;">Chờ XL</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="padding:32px;text-align:center;color:var(--success);font-size:13px;font-weight:500;">
                    <i class="bi bi-check-circle" style="font-size:24px;display:block;margin-bottom:8px;"></i>
                    Không có sự cố nào cần xử lý
                </div>
            }
        </div>
    </div>
</div>
@* ===== KẾT THÚC DASHBOARD ===== *@